SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Recarga automatica del navegador (django_browser_reload). Solo desarrollo local:
# requiere DEBUG=True y tener instalado django-browser-reload. NO definir en el servidor.
BROWSER_RELOAD=True

# Base de datos: en desarrollo local se deja sin definir (usa SQLite).
# En cPanel (Fase 7), configurar estas variables en el panel de la app Python:
# DB_ENGINE=mysql
# DB_NAME=suraycl1_suray_web_server
# DB_USER=suraycl1_suray_w
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Solo en produccion (DEBUG=False). Poner en False unicamente si cPanel aun
# no tiene el certificado SSL activo para suray.cl.
# SECURE_SSL_REDIRECT=True

# Webhook de despliegue (solo servidor; ver DEPLOY.md). Vacio = endpoint inactivo (404).
# WEBHOOK_SECRET=
